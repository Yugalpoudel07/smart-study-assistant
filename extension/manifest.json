{
  "manifest_version": 3,
  "name": "Smart Study Assistant",
  "version": "2.4",
  "description": "AI-powered study helper: simplify text, generate questions, extract keywords, and detect difficulty. Works on web pages and PDFs.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation"
  ],

  "action": {
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Smart Study Assistant — Click to open panel"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icon16.png",
        "icon48.png",
        "icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "host_permissions": [
    "https://smart-study-assistant-9u6m.onrender.com/*",
    "<all_urls>"
  ],

  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },

  "commands": {
    "toggle-panel-shortcut": {
      "suggested_key": {
        "default": "Alt+S",
        "mac":     "Alt+S"
      },
      "description": "Toggle the Smart Study Assistant panel"
    }
  },

  "options_page": "options.html",

  "homepage_url": "https://smart-study-assistant-9u6m.onrender.com",

  "minimum_chrome_version": "102"
}
